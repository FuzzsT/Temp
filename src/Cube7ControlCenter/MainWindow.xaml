<Window x:Class="Cube7ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cube7 LaserOS FullBridge Control Center 0.5.0" Height="760" Width="1180"
        MinHeight="620" MinWidth="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="CUBE 7 · LASEROS FULLBRIDGE" FontWeight="SemiBold" FontSize="22"/>
                <TextBlock Text="0.5.0 REV B · renderer health + diagnostic discovery" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#332127" BorderBrush="#8D4555" BorderThickness="1" CornerRadius="6" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="OUTPUT" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock Text="DISABLED" Foreground="#FF879B" FontWeight="Bold"/>
                    <TextBlock Text="  ·  BLE WRITES OFF  ·  DRY-RUN" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="3" Padding="10"><StackPanel><TextBlock Text="LASEROS HOOK" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="HookState" Text="WAITING" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="3" Padding="10"><StackPanel><TextBlock Text="RENDERER" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="RendererState" Text="WAITING" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="3" Padding="10"><StackPanel><TextBlock Text="CUBE7 BLE" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="BleState" Text="WAITING" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="3" Padding="10"><StackPanel><TextBlock Text="DISCOVERY 0x27" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="DiscoveryState" Text="WAITING" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="3" Padding="10"><StackPanel><TextBlock Text="FULL INFO 0x77" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="FullInfoState" Text="WAITING" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="3" Padding="10"><StackPanel><TextBlock Text="AUTH B0/B1" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="AuthState" Text="WAITING" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="#27384A">
            <TabItem Header="Overview">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bridge pipeline" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="PipelineDetail" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="Start / Restart Bridge" Click="StartBridge_Click"/>
                            <Button Content="Stop Bridge" Click="StopBridge_Click"/>
                            <Button Content="Run Self-Test" Click="RunSelfTest_Click"/>
                            <Button Content="Open Captures" Click="OpenCaptures_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#13202B" CornerRadius="6" Padding="14" Margin="15,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Safety invariants" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Physical output: DISABLED" Margin="0,12,0,0"/>
                            <TextBlock Text="Vendor BLE payload writes: OFF"/>
                            <TextBlock Text="Interlock / E-stop bypass: NONE"/>
                            <TextBlock Text="Authentication fabrication: NONE"/>
                            <TextBlock Text="Virtual SET_OUTPUT: state only"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Renderer">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="RendererDetail" Text="Waiting for renderer-hook-health.json / renderer frames." Foreground="{StaticResource TextSecondary}"/>
                    <Border Grid.Row="1" Margin="0,12,0,0" Background="#05080C" BorderBrush="#27384A" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="XY preview activates after renderer frames arrive" Foreground="#607587"/>
                            <Canvas x:Name="RendererCanvas" Margin="12" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="BLE / GATT">
                <Grid Margin="14"><TextBox x:Name="BleLog" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0A1018" Foreground="#C9D7E3" BorderThickness="0" FontFamily="Consolas"/></Grid>
            </TabItem>
            <TabItem Header="Protocol / Capture">
                <Grid Margin="14"><TextBox x:Name="ProtocolLog" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0A1018" Foreground="#C9D7E3" BorderThickness="0" FontFamily="Consolas"/></Grid>
            </TabItem>
            <TabItem Header="Settings / Safety">
                <StackPanel Margin="18">
                    <TextBlock Text="Diagnostic discovery" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="0.5.0 rev B enables the virtual LaserCube discovery responder for 0x27/0x77 diagnostics. This does not enable physical optical output or fabricate authentication." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,18"/>
                    <TextBlock x:Name="RuntimePathText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CapturePathText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterStatus" Text="Ready" Foreground="{StaticResource TextSecondary}"/>
            <TextBlock DockPanel.Dock="Right" Text="CUBE7 target E4:66:E5:D2:6E:38" Foreground="{StaticResource TextSecondary}"/>
        </DockPanel>
    </Grid>
</Window>
